---- MODULE SyncHolds ----
\* One guarded card field (for example fees.annual) across daily CDR syncs,
\* `held approve|reject` decisions from the review issue, and the git rebase
\* that lands each run on main. The sync and decision tables come from the
\* real code through SyncHoldsCode (generated by tools/verify/holds-table.ts).
EXTENDS Naturals, FiniteSets, SyncHoldsCode

CONSTANTS Vals, Start, MaxDay

Pending == {"AwaitingApproval", "AwaitingConfirmation"}
Decided == {"Approved", "Rejected"}
NoHold == "none"

VARIABLES
  day,          \* today's UTC date, as a day number
  cdr,          \* the value the issuer's CDR feed publishes now
  card,         \* the value stored in data/issuers/*/cards/*.toml on main
  hst,          \* hold state per proposed value in data/sync-holds.toml on main
  hsince,       \* hold `since` per proposed value
  issue,        \* proposed values listed as pending in the sync-held issue
  spc, sBase, sProp, sKind, sDay,   \* the sync workflow run in flight
  rpc, rBase, rVal, rDec,           \* the review-command workflow run in flight
  badApply, lost, ignored           \* history: rule breaks seen on a landing

vars == <<day, cdr, card, hst, hsince, issue, spc, sBase, sProp, sKind, sDay,
          rpc, rBase, rVal, rDec, badApply, lost, ignored>>

Repo == [card |-> card, hst |-> hst, hsince |-> hsince]

Row(prior, earlier, kind) ==
  CHOOSE r \in ResolveRows : r[1] = prior /\ r[2] = earlier /\ r[3] = kind

Decide(prior, decision) ==
  (CHOOSE r \in DecideRows : r[1] = prior /\ r[2] = decision)[3]

Init ==
  /\ day = 1
  /\ cdr = Start
  /\ card = Start
  /\ hst = [v \in Vals |-> NoHold]
  /\ hsince = [v \in Vals |-> 0]
  /\ issue = {}
  /\ spc = "idle" /\ sBase = Repo /\ sProp = Start /\ sKind = "approve" /\ sDay = 1
  /\ rpc = "idle" /\ rBase = Repo /\ rVal = Start /\ rDec = "approve"
  /\ badApply = FALSE /\ lost = FALSE /\ ignored = FALSE

\* A new UTC day starts.
NewDay ==
  /\ day < MaxDay
  /\ day' = day + 1
  /\ UNCHANGED <<cdr, card, hst, hsince, issue, spc, sBase, sProp, sKind, sDay,
                 rpc, rBase, rVal, rDec, badApply, lost, ignored>>

\* The issuer publishes another value for the field.
CdrChanges ==
  /\ \E v \in Vals \ {cdr} : cdr' = v
  /\ UNCHANGED <<day, card, hst, hsince, issue, spc, sBase, sProp, sKind, sDay,
                 rpc, rBase, rVal, rDec, badApply, lost, ignored>>

\* sync.yml checks out main and syncCdr reads the stored card and holds and the
\* CDR value. withCdrEvidence decides the candidate kind: "confirm" when the
\* previous CDR snapshot shows the issuer changed the value, else "approve".
SyncStarts ==
  /\ spc = "idle"
  /\ spc' = "running"
  /\ sBase' = Repo
  /\ sProp' = cdr
  /\ sKind' \in {"approve", "confirm"}
  /\ sDay' = day
  /\ UNCHANGED <<day, cdr, card, hst, hsince, issue, rpc, rBase, rVal, rDec,
                 badApply, lost, ignored>>

Cand(v) == IF v = sProp /\ sProp # sBase.card THEN sKind ELSE "none"

Res(v) == Row(sBase.hst[v], sBase.hsince[v] < sDay, Cand(v))

Touched(v) == sBase.hst[v] # NoHold \/ Cand(v) # "none"

OursHst(v) ==
  IF ~Touched(v) THEN NoHold ELSE IF Res(v)[5] = "gone" THEN NoHold ELSE Res(v)[5]

OursSince(v) ==
  IF ~Touched(v) \/ Res(v)[6] = "none" THEN 0
  ELSE IF Res(v)[6] = "today" THEN sDay ELSE sBase.hsince[v]

Applied == {v \in Vals : Touched(v) /\ Res(v)[4] = "apply"}

OursCard == IF Applied = {} THEN sBase.card ELSE CHOOSE v \in Applied : TRUE

\* git pull --rebase: a value both sides changed differently is a conflict.
Merge(base, ours, theirs) ==
  IF ours = base THEN theirs ELSE IF theirs = base THEN ours ELSE ours

Clash(base, ours, theirs) == ours # base /\ theirs # base /\ ours # theirs

Entry(h, s, v) == <<h[v], s[v]>>

SyncClashes ==
  \/ Clash(sBase.card, OursCard, card)
  \/ \E v \in Vals : Clash(Entry(sBase.hst, sBase.hsince, v), <<OursHst(v), OursSince(v)>>, Entry(hst, hsince, v))

MergedHst(v) == Merge(sBase.hst[v], OursHst(v), hst[v])
MergedSince(v) == Merge(sBase.hsince[v], OursSince(v), hsince[v])
MergedCard == Merge(sBase.card, OursCard, card)

ApplyAllowed(v) ==
  \/ sBase.hst[v] = "Approved"
  \/ sKind = "confirm" /\ sBase.hst[v] \in Pending /\ sBase.hsince[v] < sDay

\* The run commits data/ and pushes; the rebase conflicts, or the push lands
\* and the "Report held changes" step rewrites the sync-held issue.
SyncLands ==
  /\ spc = "running"
  /\ spc' = "idle"
  /\ IF SyncClashes
       THEN UNCHANGED <<card, hst, hsince, issue, badApply, lost, ignored>>
       ELSE
         /\ card' = MergedCard
         /\ hst' = [v \in Vals |-> MergedHst(v)]
         /\ hsince' = [v \in Vals |-> MergedSince(v)]
         /\ issue' = {v \in Vals : MergedHst(v) \in Pending}
         /\ badApply' = (badApply \/ (OursCard # sBase.card /\ ~ApplyAllowed(OursCard)))
         /\ lost' = (lost \/ \E v \in Vals : hst[v] \in Decided /\ MergedHst(v) \in Pending)
         /\ ignored' = (ignored \/ (sBase.hst[sProp] = "Approved" /\ sProp # sBase.card /\ OursCard # sProp))
  /\ UNCHANGED <<day, cdr, sBase, sProp, sKind, sDay, rpc, rBase, rVal, rDec>>

\* A maintainer comments /approve or /reject with a hold id from the issue;
\* review-command.yml checks out main and runs decideHold.
ReviewStarts ==
  /\ rpc = "idle"
  /\ \E v \in issue, d \in {"approve", "reject"} :
       /\ rVal' = v
       /\ rDec' = d
  /\ rpc' = "running"
  /\ rBase' = Repo
  /\ UNCHANGED <<day, cdr, card, hst, hsince, issue, spc, sBase, sProp, sKind, sDay,
                 badApply, lost, ignored>>

RevNext == IF rBase.hst[rVal] = NoHold THEN "refused" ELSE Decide(rBase.hst[rVal], rDec)

RevOurs(v) == IF v = rVal /\ RevNext # "refused" THEN RevNext ELSE rBase.hst[v]

RevClashes ==
  \E v \in Vals : Clash(Entry(rBase.hst, rBase.hsince, v), <<RevOurs(v), rBase.hsince[v]>>, Entry(hst, hsince, v))

\* The decision commit is pushed (rebasing onto main), or the job fails and
\* replies on the issue.
ReviewLands ==
  /\ rpc = "running"
  /\ rpc' = "idle"
  /\ IF RevNext = "refused" \/ RevClashes
       THEN UNCHANGED <<hst, lost>>
       ELSE
         /\ hst' = [v \in Vals |-> Merge(rBase.hst[v], RevOurs(v), hst[v])]
         /\ lost' = (lost \/ \E v \in Vals : hst[v] \in Decided /\ hst'[v] \in Pending)
  /\ UNCHANGED <<day, cdr, card, hsince, issue, spc, sBase, sProp, sKind, sDay,
                 rBase, rVal, rDec, badApply, ignored>>

Next ==
  \/ NewDay
  \/ CdrChanges
  \/ SyncStarts
  \/ SyncLands
  \/ ReviewStarts
  \/ ReviewLands

Spec == Init /\ [][Next]_vars

\* Rules a maintainer agrees to.
NoUnreviewedApply == ~badApply
RejectedValueNeverStored == \A v \in Vals : ~(card = v /\ hst[v] = "Rejected")
DecisionNeverLost == ~lost
ApprovedValueApplied == ~ignored
OneHoldPerField == Cardinality({v \in Vals : hst[v] # NoHold}) <= 1
====
