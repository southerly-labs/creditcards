{
  "name": "creditcards",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "sync": "bun run src/cli.ts sync",
    "validate": "bun run src/cli.ts validate",
    "build": "bun run src/cli.ts build && bun run web/build.ts",
    "test": "bun test",
    "typecheck": "tsrs --noEmit",
    "dev": "bun run build && bun run web/server.ts",
    "check": "tsrs --noEmit && bun test && bun run validate && bun run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0",
    "effect": "4.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "tsrs": "0.20.1-ts7.1.0-beta"
  }
}
