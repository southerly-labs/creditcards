{
  "name": "creditcards",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "sync": "bun run src/cli.ts sync",
    "validate": "bun run src/cli.ts validate",
    "build": "bun run src/cli.ts build && bun run web/build.ts",
    "test": "bun --bun run vitest run",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "dev": "bun run build && bun run web/server.ts",
    "check": "bun run format:check && effect-tsgo tsrs --noEmit && bun run lint && bun run test && bun run validate && bun run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run comments:check && oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives . && bun run comments:check",
    "comments:check": "bun tools/oxlint/local/check-comments.ts",
    "verify:holds": "bash tools/verify/run.sh .cursor/skills/verify-sync-holds SyncHolds holds-table.ts",
    "verify:lifecycle": "bash tools/verify/run.sh .cursor/skills/verify-card-lifecycle CardLifecycle lifecycle-table.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0",
    "@typeonce/effect-machine": "0.46.0",
    "effect": "4.1.0",
    "smol-toml": "1.9.1",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.7",
    "@oxlint/plugins": "1.90.0",
    "@shekohex/oxc-effect": "0.2.1",
    "@types/bun": "1.4.4",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
