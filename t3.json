{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/icon.svg",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "bun install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Check",
      "command": "bun run check",
      "icon": "test"
    },
    {
      "name": "Dev",
      "command": "bun run dev",
      "icon": "play"
    },
    {
      "name": "Sync dry run",
      "command": "bun run sync -- --dry-run",
      "icon": "debug"
    }
  ]
}
