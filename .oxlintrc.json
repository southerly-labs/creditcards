{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false,
        "checkThenables": true
      }
    ],
    "typescript/no-misused-promises": "error",
    "no-redeclare": "off",
    "eqeqeq": ["error", "smart"],
    "unicorn/no-useless-undefined": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "import/max-dependencies": "off",
    "effect/no-effect-succeed-variable": "error",
    "effect/no-flatmap-ladder": "error",
    "effect/no-match-tag-neutral-fallback": "error",
    "effect/no-option-effect-branch": "error",
    "effect/prefer-effect-async": "error",
    "effect/prefer-assert-in-effect-test": "error",
    "effect/prefer-effect-cache": "error",
    "effect/prefer-effect-child-process": "error",
    "effect/prefer-effect-date-time": "error",
    "effect/prefer-effect-http-client": "error",
    "effect/prefer-effect-scheduling": "error",
    "effect/prefer-match-value-tags": "error",
    "effect/prefer-effect-test-layer": "error",
    "effect/prefer-schema-json": "error",
    "effect/no-return-in-arrow": "error",
    "effect/no-return-in-callback": "error",
    "effect/warn-effect-sync-wrapper": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-object-parameters": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/prefer-effect-match": "error"
  },
  "ignorePatterns": ["dist/**", "tools/oxlint/anti-slop/**"],
  "extends": ["./node_modules/@shekohex/oxc-effect/configs/full.jsonc"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ]
}
