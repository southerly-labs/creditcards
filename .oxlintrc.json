{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false,
        "checkThenables": true
      }
    ],
    "typescript/no-misused-promises": "error",
    "no-redeclare": "off",
    "eqeqeq": ["error", "smart"],
    "unicorn/no-useless-undefined": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "import/max-dependencies": "off",
    "effect/no-effect-succeed-variable": "error",
    "effect/no-flatmap-ladder": "error",
    "effect/no-match-tag-neutral-fallback": "error",
    "effect/no-option-effect-branch": "error",
    "effect/prefer-effect-async": "error",
    "effect/prefer-assert-in-effect-test": "error",
    "effect/prefer-effect-cache": "error",
    "effect/prefer-effect-child-process": "error",
    "effect/prefer-effect-date-time": "error",
    "effect/prefer-effect-http-client": "error",
    "effect/prefer-effect-scheduling": "error",
    "effect/prefer-match-value-tags": "error",
    "effect/prefer-effect-test-layer": "error",
    "effect/prefer-schema-json": "error",
    "effect/no-return-in-arrow": "error",
    "effect/no-return-in-callback": "error",
    "effect/warn-effect-sync-wrapper": "error"
  },
  "ignorePatterns": ["dist/**"],
  "extends": ["./node_modules/@shekohex/oxc-effect/configs/full.jsonc"]
}
